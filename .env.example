# uFawkes integration (optional — connect to your observability stack)
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_SERVICE_NAME=my-project

# DORA metrics
# Optional: for external/future GitHub API-backed DORA collectors
# (current scripts/weekly-metrics.sh uses local git + coverage data)
GITHUB_TOKEN=
# Your GitHub org or username
GITHUB_OWNER=
# This repository name
GITHUB_REPO=

# uFawkesObs delivery events (scripts/emit-dora-event.sh)
# When OTEL_EXPORTER_OTLP_ENDPOINT is set, each event is also POSTed to
# ${OTEL_EXPORTER_OTLP_ENDPOINT}/v1/logs; uFawkesObs routes OTLP logs to Loki.
# Optional extra OTLP headers as comma-separated key=value pairs (e.g. for an
# authenticating gateway) — put real values in `.env` or a CI secret.
OTEL_EXPORTER_OTLP_HEADERS=
# Environment named in deploy-marker events and their uFawkesDORA deployment event
DORA_ENVIRONMENT=production
# Optional: also append every event as one JSON line to this file
DORA_EVENTS_FILE=
