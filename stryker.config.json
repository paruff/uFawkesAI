{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "testRunner": "command",
  "commandRunner": {
    "command": "bash scripts/test-sdlc-seam.sh"
  },
  "mutate": [
    "scripts/seam/**/*.ts"
  ],
  "coverageAnalysis": "off",
  "reporters": [
    "clear-text",
    "json"
  ],
  "jsonReporter": {
    "fileName": "reports/mutation/mutation.json"
  },
  "thresholds": {
    "high": 80,
    "low": 60,
    "break": 45
  },
  "inPlace": true
}
