{
  "name": "uFawkesAI Development",
  "image": "ghcr.io/paruff/fawkes-space:latest",
  "customizations": {
    "vscode": {
      "extensions": [
        "GitHub.copilot",
        "GitHub.copilot-chat",
        "GitHub.vscode-pull-request-github",
        "dbaeumer.vscode-eslint",
        "esbenp.prettier-vscode",
        "streetsidesoftware.code-spell-checker",
        "yzhao062.agent-style"
      ],
      "settings": {
        "editor.formatOnSave": true,
        "editor.defaultFormatter": "esbenp.prettier-vscode",
        "github.copilot.enable": {
          "*": true
        }
      }
    }
  },
  "forwardPorts": [],
  "remoteUser": "dev",
  "postCreateCommand": "echo 'uFawkesAI devcontainer ready — all tools pre-installed'",
  "hostRequirements": {
    "cpus": 2,
    "memory": "4gb"
  }
}
